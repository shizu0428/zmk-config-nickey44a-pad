#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        esc1 {
            bindings = <&kp ESCAPE>;
            key-positions = <1 0>;
        };

        win {
            bindings = <&kp LEFT_WIN>;
            key-positions = <15 14 13>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <10 11>;
        };

        mb3 {
            bindings = <&mkp MB3>;
            key-positions = <13 15>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        new_ht: new_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_HT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q            &kp W               &kp E                   &kp R                 &kp T      &trans                           &trans         &kp Y        &kp U                 &kp I                       &kp O                    &kp P
&kp A            &kp S               &kp D                   &kp F                 &kp G      &trans                           &trans         &kp H        &kp J                 &kp K                       &kp L                    &kp MINUS
&new_ht LSHFT Z  &new_ht LEFT_ALT X  &new_ht LEFT_CONTROL C  &new_ht LEFT_SHIFT V  &kp B      &trans       &trans      &trans  &trans         &kp N        &new_ht LEFT_SHIFT M  &new_ht LEFT_CONTROL COMMA  &new_ht LEFT_ALT PERIOD  &kp SLASH
                                                                                   &lt 1 TAB  &lt 2 SPACE  &mkp MB1    &trans  &kp BACKSPACE  &lt 3 ENTER
            >;
        };

        layer_1 {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(SLASH)  &kp LS(NUMBER_3)  &kp LS(N5)  &kp LS(NUMBER_6)  &trans                    &trans          &kp LS(N7)        &kp LS(N8)         &kp LS(N9)            &trans         &kp PLUS
&kp LEFT_BRACKET  &kp DOLLAR     &trans            &trans      &trans            &trans                    &trans          &kp LS(NUMBER_2)  &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH  &kp SEMICOLON  &kp SQT
&trans            &trans         &trans            &trans      &trans            &trans  &trans    &trans  &trans          &trans            &trans             &trans                &trans         &kp LS(INTERNATIONAL_1)
                                                               &trans            &trans  &trans    &trans  &kp LANGUAGE_1  &kp LANGUAGE_2
            >;
        };

        layer_2 {
            bindings = <
&trans  &kp F7  &kp F8  &kp F9  &kp F10  &trans                    &trans  &kp LS(N7)   &kp N7        &kp N8        &kp N9        &kp LS(MINUS)
&trans  &trans  &kp F5  &trans  &kp F11  &trans                    &trans  &kp LS(SQT)  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans
&trans  &trans  &kp F2  &trans  &kp F12  &trans  &trans    &trans  &trans  &kp SLASH    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp COLON
                                &trans   &trans  &trans    &trans  &trans  &kp N0
            >;
        };

        layer_3 {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(SLASH)  &kp LS(NUMBER_3)  &kp LS(N5)    &kp LS(NUMBER_6)  &trans                    &trans          &trans          &kp HOME  &kp UP    &kp END    &trans
&kp LEFT_BRACKET  &kp DOLLAR     &trans            &trans        &trans            &trans                    &trans          &trans          &kp LEFT  &kp DOWN  &kp RIGHT  &trans
&trans            &bt BT_SEL 0   &bt BT_SEL 1      &bt BT_SEL 2  &bt BT_SEL 3      &trans  &trans    &trans  &trans          &trans          &trans    &trans    &trans     &trans
                                                                 &trans            &trans  &trans    &trans  &kp LANGUAGE_1  &kp LANGUAGE_2
            >;
        };
    };
};
